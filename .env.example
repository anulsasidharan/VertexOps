# VertexOps — environment configuration template
# Copy this file to .env and fill in the values for your environment.
# Lines marked REQUIRED must be set; the app will not start without them.
# Never commit the real .env file to version control.

# =============================================================================
# Application
# =============================================================================
# development | staging | production
APP_ENV=development
APP_NAME=VertexOps
APP_VERSION=0.1.0
DEBUG=false
# JSON array (pydantic-settings parses list fields as JSON from .env)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# If you start Postgres with `docker compose up -d postgres` (see root docker-compose.yml),
# use this URL from the host (user/password in compose: vertexops / vertexops):
# DATABASE_URL=postgresql+asyncpg://vertexops:vertexops@localhost:5432/vertexops
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vertexops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Auth  (REQUIRED)
# =============================================================================
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET_KEY=change-me-use-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Random pepper added to API keys before hashing: openssl rand -hex 16
API_KEY_PEPPER=change-me-use-a-strong-random-pepper
# When false, POST /api/v1/auth/register returns 403 (users created via ops / bootstrap only).
ALLOW_PUBLIC_SIGNUP=true

# =============================================================================
# LLM providers
# =============================================================================
# OPENAI_API_KEY is optional; required when using OpenAI for embeddings or chat
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3

# =============================================================================
# GCP / Vertex AI
# =============================================================================
# Required when using Vertex AI models or GCS object storage
GCP_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_EMBEDDING_MODEL=text-embedding-004
VERTEX_AI_CHAT_MODEL=gemini-1.5-flash

# =============================================================================
# Vector store (Pinecone)
# =============================================================================
# Required when using Pinecone as the vector backend
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=vertexops-index

# =============================================================================
# Object storage
# =============================================================================
# local (default, no cloud credentials needed) | gcs (production GCP)
STORAGE_BACKEND=local
# GCS bucket for raw documents and eval artifacts (Vertex AI / GCP)
GCS_BUCKET_NAME=
# Fallback local path for development without cloud storage
STORAGE_LOCAL_PATH=./storage

# =============================================================================
# Observability
# =============================================================================
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
# Set to true to expose GET /api/v1/metrics (Prometheus scrape endpoint)
METRICS_ENABLED=false
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=vertexops-evaluations
# OTLP gRPC endpoint for OpenTelemetry traces (e.g. http://otel-collector:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=
# For Prometheus multi-process mode (gunicorn + multiple workers) set this dir
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# =============================================================================
# Notifications (optional — Task #34)
# =============================================================================
NOTIFICATIONS_ENABLED=false
NOTIFICATION_ALERT_EMAILS=
NOTIFICATIONS_SENDGRID_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
NOTIFICATIONS_TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ALERT_TO_NUMBER=

# =============================================================================
# Billing / usage metering (optional — Task #35)
# =============================================================================
STRIPE_METERING_ENABLED=false
STRIPE_API_KEY=
# If set, overrides logical event names when posting to Stripe meter_events.
STRIPE_METER_EVENT_NAME=
